# Copy to .env. Never commit .env.

# mock (default, scripted answers), gemini or ollama
LLM_MODE=mock

# gemini: free tier key from Google AI Studio, needs `pip install google-genai`
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ollama: local model, run `ollama pull gemma3:4b` first
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# where the pipeline finds the fake publisher site
FAKE_SITE_URL=http://localhost:8001
